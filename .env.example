# Public client-side Flagsmith environment key (safe for browser)
VITE_FLAGSMITH_ENV_KEY=your_client_side_environment_key

# Server-side Flagsmith Admin/API key for /api/lab (NEVER expose to browser)
FLAGSMITH_API_KEY=your_flagsmith_api_key

# Optional GitHub personal access token for higher /api/card rate limits
GITHUB_TOKEN=
